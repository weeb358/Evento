# Values for a hosted Supabase project (Project Settings -> API).
# Used by `supabase link` and any local scripts — never commit the real .env.
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
SUPABASE_ACCESS_TOKEN=

# Google OAuth (Web client) — Google Cloud Console > APIs & Services >
# Credentials > OAuth client ID > Web application.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gmail SMTP — smtp.gmail.com:587 using a Gmail App Password (not your
# normal password): https://myaccount.google.com/apppasswords
GMAIL_SMTP_USER=
GMAIL_SMTP_PASS=
