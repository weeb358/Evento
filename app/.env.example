SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Password-reset emails link here to complete the reset (see
# docs/ARCHITECTURE.md for why the app doesn't handle the link itself via a
# native deep link) — point this at your deployed website, or
# http://localhost:3000 while developing both together.
WEBSITE_URL=http://localhost:3000

# Google Sign-In — the Google Cloud OAuth **Web** client ID (not the Android
# one). See docs/ARCHITECTURE.md for exactly how to get this and wire it
# into Supabase's Google provider.
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
